    <p class="poster-hello">xin chào,</p>
    <p class="poster-line">
      <span class="poster-sans">I craft for</span>
      <span class="poster-serif">emotion.</span>
    </p>
    <div class="poster-caps">
      <p class="poster-sub">product designer</p>
      <p class="poster-sub">
        recently: master of hci+d
        <a class="handle" href={site.links.uw} target="_blank" rel="noopener noreferrer">@uw</a>
      </p>
    </div>
    <p class="poster-sub poster-sub--merged">
      product designer · mhci+d
      <a class="handle" href={site.links.uw} target="_blank" rel="noopener noreferrer">@uw</a>
    </p>
